{
  "name": "@eliware/codescope",
  "version": "8.0.0",
  "description": "A structured OpenAI CLI for focused codebase reviews, suggestions, and token estimates.",
  "author": "Eliware <eliware@eliware.org>",
  "keywords": [
    "code-review",
    "documentation",
    "openai",
    "cli",
    "architecture",
    "security",
    "testing",
    "release-readiness",
    "static-analysis",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/eliware/codescope.git"
  },
  "bugs": {
    "url": "https://github.com/eliware/codescope/issues"
  },
  "homepage": "https://github.com/eliware/codescope#readme",
  "type": "module",
  "bin": {
    "codescope": "bin/codescope.mjs"
  },
  "exports": {
    ".": "./src/cli.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "docs/",
    "scripts/",
    "examples/",
    "specs/",
    "KNOWN_ISSUES.md",
    "NEW_FEATURE_SUGGESTIONS.md",
    "LICENSE",
    "RELEASE_NOTES.md"
  ],
  "scripts": {
    "test": "eliware-test",
    "lint": "eliware-test --lint",
    "benchmark:efforts": "node scripts/benchmark-efforts.mjs",
    "format": "prettier --write bin src tests examples README.md AGENTS.md RELEASE_NOTES.md docs specs *.md",
    "format:check": "prettier --check bin src tests examples README.md AGENTS.md RELEASE_NOTES.md docs specs *.md"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@eliware/test": "^4.0.0",
    "prettier": "^3.9.6"
  },
  "license": "MIT",
  "eliware": {
    "conventions": {
      "version": "8.0",
      "apply": [
        "general",
        "node",
        "application",
        "cli"
      ],
      "exemptions": []
    },
    "authority": {
      "authoritativeFor": [
        "CodeScope CLI behavior, review profiles, and supplied-evidence conventions."
      ],
      "notAuthoritativeFor": [
        "Repository runtime behavior, CI execution results, publication, deployment, or registry state."
      ]
    },
    "crosslinks": [
      {
        "path": "specs/conventions.json",
        "relation": "relatedAuthority",
        "authoritativeFor": "Convention v8 applicability and directive references."
      }
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@eliware/common": "^2.0.0",
    "@eliware/openai": "^1.1.11",
    "@eliware/redact": "file:../redact"
  }
}
