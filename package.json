{
    "name": "codescope",
    "version": "2.0.0",
    "description": "An OpenAI-powered command-line tool for focused code and documentation reviews.",
    "keywords": [
        "code-review",
        "documentation",
        "openai",
        "cli"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/eliware/codescope.git"
    },
    "bugs": {
        "url": "https://github.com/eliware/codescope/issues"
    },
    "homepage": "https://github.com/eliware/codescope#readme",
    "type": "module",
    "bin": {
        "codescope": "bin/codescope.mjs"
    },
    "exports": {
        ".": "./src/cli.mjs"
    },
    "files": [
        "bin/",
        "src/",
        "README.md",
        "docs/",
        "LICENSE",
        "RELEASE_NOTES.md"
    ],
    "scripts": {
        "test": "eliware-test",
        "lint": "eliware-test --lint",
        "pack": "npm pack --dry-run"
    },
    "engines": {
        "node": ">=26"
    },
    "devDependencies": {
        "@eliware/test": "^2.3.0"
    },
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@eliware/common": "^2.0.0",
        "@eliware/openai": "^1.1.11"
    }
}
