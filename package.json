{
  "name": "@eliware/codescope",
  "version": "11.0.0",
  "description": "A structured OpenAI CLI for focused codebase reviews, suggestions, and token estimates.",
  "author": "Eliware <eliware@eliware.org>",
  "keywords": [
    "code-review",
    "documentation",
    "openai",
    "cli",
    "architecture",
    "security",
    "testing",
    "release-readiness",
    "static-analysis",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliware/codescope.git"
  },
  "bugs": {
    "url": "https://github.com/eliware/codescope/issues"
  },
  "homepage": "https://github.com/eliware/codescope#readme",
  "type": "module",
  "private": false,
  "bin": {
    "codescope": "bin/codescope.mjs"
  },
  "exports": {
    ".": "./src/cli/main.mjs"
  },
  "files": [
    "src/",
    "docs/",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "RELEASE_NOTES.md",
    "bin/"
  ],
  "scripts": {
    "test": "eliware-test",
    "lint": "eliware-test --lint",
    "audit": "eliware-test --audit",
    "pack": "eliware-test --pack",
    "format": "eliware-test --format",
    "format:check": "eliware-test --format-check"
  },
  "engines": {
    "node": "26"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.mjs"
    ],
    "collectCoverageFrom": [
      "src/**/*.mjs"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    },
    "coverageReporters": [
      "text",
      "json-summary"
    ]
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "proseWrap": "preserve",
    "endOfLine": "lf"
  },
  "license": "MIT",
  "eliware": {
    "id": "E-1210",
    "apply": [
      "general",
      "application",
      "cli",
      "npm-published"
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@eliware/common": "^2.0.0",
    "@eliware/openai": "^1.1.11",
    "@eliware/redact": "6.0.0"
  },
  "devDependencies": {
    "eliware-test": "npm:@eliware/test@^11.0.0"
  }
}
